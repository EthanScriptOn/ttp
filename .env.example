# MySQL container credentials. Generate unique values for local use.
MYSQL_DATABASE=cicd_platform
MYSQL_USER=cicd_app
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password

# Used only when the database does not already contain the admin user.
CICD_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-local-admin-password

# Demo mode is intentionally disabled in the production startup path.
# CICD_DEMO_MODE=true
# CICD_DEMO_ADMIN_PASSWORD=replace-with-a-local-demo-password

# Set a stable value outside local demos so existing sessions survive restarts.
CICD_JWT_SECRET=replace-with-a-long-random-secret
# Required by the real Kubernetes runtime. For local kubeconfig use `local`.
CICD_KUBE_CLUSTER_ID=local
# ServiceAccount that TTP binds into every generated environment namespace.
CICD_KUBE_SERVICE_ACCOUNT_NAMESPACE=ttp-system
CICD_KUBE_SERVICE_ACCOUNT_NAME=ttp-runtime
# Optional bootstrap value. If the key file already exists, the persisted file
# wins so a stale shell variable cannot make stored credentials unreadable.
# CICD_GIT_CREDENTIAL_KEY=replace-with-a-long-random-secret
CICD_GIT_CREDENTIAL_KEY_FILE=.runtime/credential.key
